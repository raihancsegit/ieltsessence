# IELTS ESSENCE Email & Lead Notification Settings
# To send emails directly to your inbox when a student submits the modal form:

# Gmail Example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourbusiness@gmail.com
# SMTP_PASS=your_gmail_16_digit_app_password
# NOTIFICATION_EMAIL=yourdestination@gmail.com

# cPanel / Webmail Example:
# SMTP_HOST=mail.ieltsessence.com
# SMTP_PORT=465
# SMTP_USER=admission@ieltsessence.com
# SMTP_PASS=YourEmailPassword
# NOTIFICATION_EMAIL=director@ieltsessence.com
